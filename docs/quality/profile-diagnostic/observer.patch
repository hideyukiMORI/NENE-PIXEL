+                ProfileDiagnosticContext("bad.session", 1, 1234),
+                tick::incrementAndGet,
+                lines::add,
+            )
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            ProfileDiagnosticRecorder(ProfileDiagnosticContext("safe", 16, 1234), tick::incrementAndGet, lines::add)
+        }
+        assertThrows(IllegalArgumentException::class.java) { ProfileDiagnosticLimits(eventLimit = 4_097) }
+        assertThrows(IllegalArgumentException::class.java) { ProfileDiagnosticLimits(tokenLimit = 129) }
+        assertTrue(lines.isEmpty())
+    }
+
+    @Test
+    fun unsupportedGateIsRejectedWithoutInspectingOrLoggingItsContent() {
+        val lines = mutableListOf<String>()
+        val recorder = recorder(lines)
+        val sourceBearingGate =
+            object {
+                override fun toString(): String = error("The diagnostic inspected a source-bearing gate")
+            }
+        recorder.observe(
+            AutosaveSchedulerEvent.Sample(
+                1,
+                AutosaveObservation(AutosaveStateObservation(null, null, null), sourceBearingGate, 0),
+            ),
+        )
+
+        assertEquals(2, lines.size)
+        assertTrue(lines.last().contains("\"reason\":\"unsupported_gate\""))
+        assertFalse(lines.any { it.contains("sourceBearingGate") })
+    }
+
+    @Test
+    fun processHeaderHasAllRequiredKeysWithExpectedJsonTypes() {
+        val lines = mutableListOf<String>()
+        recorder(lines)
+        val expected =
+            Regex(
+                """^\{"schema":"nene-pixel-profile-diagnostic-v1","session":"diag_190","iteration":1,""" +
+                    """"role":"app","pid":1234,"origin_ns":\d+,"seq":1,"t_ns":\d+,"event":"process_begin"\}$""",
+            )
+        assertTrue(expected.matches(lines.single()))
+    }
+
+    @Test
+    fun foldClockDomainIsExplicit() {
+        val lines = mutableListOf<String>()
+        val recorder = recorder(lines)
+        recorder.observe(
+            AutosaveSchedulerEvent.FoldAttempt(
+                sampleId = 1,
+                attemptId = 1,
+                branch = AutosaveFoldBranch.NO_REQUESTABLE,
+                reading = AutosaveSchedulerEvent.FoldReading(500L, null),
+            ),
+        )
+        assertTrue(lines.last().contains("\"fold_now_ns\":500"))
+        assertTrue(lines.last().contains("\"deadline_clock\":\"scheduler_nano_time\""))
+    }
+
+    private fun recorder(
+        lines: MutableList<String>,
+        tokenLimit: Int = 128,
+    ): ProfileDiagnosticRecorder {
+        val tick = AtomicLong(100_000L)
+        return ProfileDiagnosticRecorder(
+            ProfileDiagnosticContext("diag_190", 1, 1234),
+            tick::incrementAndGet,
+            lines::add,
+            ProfileDiagnosticLimits(tokenLimit = tokenLimit),
+        )
+    }
+
+    private fun publicationEvents(lines: List<String>): List<String> =
+        lines.filter { it.contains("\"event\":\"publication_") }
+
+    private fun eventName(line: String): String =
+        Regex("\"event\":\"([a-z_]+)\"").find(line)?.groupValues?.get(1) ?: error("Missing diagnostic event")
+
+    private fun sequenceNumber(line: String): Int =
+        Regex("\"seq\":(\\d+)")
+            .find(line)
+            ?.groupValues
+            ?.get(1)
+            ?.toInt() ?: error("Missing sequence")
+}
+
+private class FixedOutcomeRecoveryRecordPort(
+    private val outcome: RecoveryPublicationOutcome,
+) : RecoveryRecordPort {
+    override suspend fun inspect(): RecoveryInspection = RecoveryInspection.Missing
+
+    override suspend fun retire(expected: ExpectedRecoveryLineage): RecoveryRetirementOutcome =
+        RecoveryRetirementOutcome.GenerationExhausted
+
+    override suspend fun publishCandidate(
+        expected: ExpectedRecoveryLineage,
+        document: DocumentState,
+    ): RecoveryPublicationOutcome = outcome
+}
+
+private class CancellingRecoveryRecordPort : RecoveryRecordPort {
+    override suspend fun inspect(): RecoveryInspection = RecoveryInspection.Missing
+
+    override suspend fun retire(expected: ExpectedRecoveryLineage): RecoveryRetirementOutcome =
+        RecoveryRetirementOutcome.GenerationExhausted
+
+    override suspend fun publishCandidate(
+        expected: ExpectedRecoveryLineage,
+        document: DocumentState,
+    ): RecoveryPublicationOutcome = throw CancellationException("diagnostic fixture")
+}
