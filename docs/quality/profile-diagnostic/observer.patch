+package io.github.hideyukimori.nenepixel
+
+import io.github.hideyukimori.nenepixel.core.application.persistence.AutosaveRequestResult
+import io.github.hideyukimori.nenepixel.core.application.persistence.AutosaveStateToken
+
+internal fun interface AutosaveSchedulerDiagnostics {
+    fun observe(event: AutosaveSchedulerEvent)
+
+    companion object {
+        val None: AutosaveSchedulerDiagnostics = AutosaveSchedulerDiagnostics { }
+    }
+}
+
+internal sealed interface AutosaveSchedulerEvent {
+    data class Sample(
+        val sampleId: Long,
+        val sample: AutosaveObservation,
+    ) : AutosaveSchedulerEvent
+
+    data class FoldAttempt(
+        val sampleId: Long,
+        val attemptId: Int,
+        val branch: AutosaveFoldBranch,
+        val reading: FoldReading,
+    ) : AutosaveSchedulerEvent
+
+    data class FoldReading(
+        val nowNanos: Long,
+        val helperResult: Boolean?,
+    )
+
+    data class FoldCommitted(
+        val sampleId: Long,
+        val attemptId: Int,
+        val state: AutosaveSchedule,
+    ) : AutosaveSchedulerEvent
+
+    data class Flush(
+        val count: Long,
+    ) : AutosaveSchedulerEvent
+
+    data class Decision(
+        val branch: AutosaveSchedulerDecision,
+        val dueNanos: Long?,
+        val reading: DecisionReading,
+    ) : AutosaveSchedulerEvent
+
+    data class DecisionReading(
+        val nowNanos: Long,
+        val state: AutosaveSchedule,
+    )
+
+    data class RequestBegin(
+        val token: AutosaveStateToken,
+    ) : AutosaveSchedulerEvent
+
+    data class RequestEnd(
+        val token: AutosaveStateToken,
+        val result: AutosaveRequestResult,
+    ) : AutosaveSchedulerEvent
+
+    data class RequestIncomplete(
+        val token: AutosaveStateToken,
+    ) : AutosaveSchedulerEvent
+}
+
+internal enum class AutosaveSchedulerDecision { NO_DUE, WAIT, DUE, CAS_RETRY }
