+import io.github.hideyukimori.nenepixel.core.application.persistence.PersistenceLastOutcome
+import io.github.hideyukimori.nenepixel.core.application.persistence.PersistenceOperationHandle
+import io.github.hideyukimori.nenepixel.core.application.persistence.PersistenceOperationPhase
+import io.github.hideyukimori.nenepixel.core.application.persistence.PersistenceOperationProjection
+import io.github.hideyukimori.nenepixel.core.application.persistence.RecoveryPublicationOutcome
+import io.github.hideyukimori.nenepixel.core.application.persistence.RecoveryStatus
+
+/** Bounded, process-local #190 diagnostic stream. Only this prepared patch contains the recorder. */
+internal class ProfileDiagnosticRecorder(
+    context: ProfileDiagnosticContext,
+    nanos: () -> Long,
+    sink: (String) -> Unit,
+    limits: ProfileDiagnosticLimits = ProfileDiagnosticLimits(),
+) : AutosaveDiagnosticObserver,
+    AutosaveSchedulerDiagnostics {
+    private val lock = Any()
+    private val writer = ProfileDiagnosticWriter(context, nanos, sink, limits)
+    private val registry = ProfileDiagnosticRegistry(writer, limits)
+
+    override fun observe(event: AutosaveDiagnosticEvent) {
+        synchronized(lock) {
+            if (writer.invalid) return
+            when (event) {
+                is AutosaveDiagnosticEvent.RuntimeOperationSet -> {
+                    operationSet(event)
+                }
+
+                is AutosaveDiagnosticEvent.RuntimeAutosaveSet -> {
+                    autosaveSet(event)
+                }
+
+                is AutosaveDiagnosticEvent.PublicationPortBegin -> {
+                    publication("publication_port_begin", event.token, event.operation)
+                }
+
+                is AutosaveDiagnosticEvent.PublicationPortEnd -> {
+                    publication(
+                        "publication_port_end",
+                        event.token,
+                        event.operation,
+                        "result" to publicationResult(event.outcome),
+                    )
+                }
+
+                is AutosaveDiagnosticEvent.PublicationRuntimeComplete -> {
+                    publication(
+                        "publication_runtime_complete",
+                        event.token,
+                        event.operation,
+                        "result" to requestResult(event.result),
+                    )
+                }
+
+                is AutosaveDiagnosticEvent.PublicationIncomplete -> {
+                    publication(
+                        "publication_incomplete",
+                        event.token,
+                        event.operation,
+                        "reason" to event.reason.name.lowercase(),
+                    )
+                }
+            }
+        }
+    }
+
+    private fun operationSet(event: AutosaveDiagnosticEvent.RuntimeOperationSet) {
+        val old = registry.gateId(event.transition.old)
+        val new = registry.gateId(event.transition.new)
+        if (!writer.invalid) {
+            writer.emit(
+                "runtime_operation_set",
+                "set_id" to event.setId,
+                "stage" to event.stage.name.lowercase(),
+                "old_gate" to old,
+                "new_gate" to new,
+                *registry.gateFields("old", event.transition.old).toTypedArray(),
+                *registry.gateFields("new", event.transition.new).toTypedArray(),
+                "changed" to event.transition.changed,
+            )
+        }
+    }
+
+    private fun autosaveSet(event: AutosaveDiagnosticEvent.RuntimeAutosaveSet) {
+        val old = registry.autosaveFields("old", event.transition.old)
+        val new = registry.autosaveFields("new", event.transition.new)
+        if (!writer.invalid) {
+            writer.emit(
+                "runtime_autosave_set",
+                "set_id" to event.setId,
+                "stage" to event.stage.name.lowercase(),
+                *(old + new + ("changed" to event.transition.changed)).toTypedArray(),
+            )
+        }
+    }
+
+    override fun observe(event: AutosaveSchedulerEvent) {
+        synchronized(lock) {
+            if (writer.invalid) return
+            when (event) {
+                is AutosaveSchedulerEvent.Sample -> {
+                    schedulerSample(event)
+                }
+
+                is AutosaveSchedulerEvent.FoldAttempt -> {
+                    foldAttempt(event)
+                }
+
+                is AutosaveSchedulerEvent.FoldCommitted -> {
+                    foldCommitted(event)
+                }
+
+                is AutosaveSchedulerEvent.Flush -> {
+                    writer.emit("scheduler_flush", "count" to event.count)
+                }
+
+                is AutosaveSchedulerEvent.Decision -> {
+                    schedulerDecision(event)
+                }
+
+                is AutosaveSchedulerEvent.RequestBegin -> {
+                    tokenEvent("scheduler_request_begin", event.token)
+                }
+
+                is AutosaveSchedulerEvent.RequestEnd -> {
+                    tokenEvent("scheduler_request_end", event.token, "result" to requestResult(event.result))
+                }
+
+                is AutosaveSchedulerEvent.RequestIncomplete -> {
+                    tokenEvent("scheduler_request_incomplete", event.token)
+                }
+            }
+        }
+    }
+
+    private fun schedulerSample(event: AutosaveSchedulerEvent.Sample) {
+        val fields = registry.observationFields(event.sample)
+        if (!writer.invalid) writer.emit("scheduler_sample", "sample_id" to event.sampleId, *fields.toTypedArray())
+    }
+
+    private fun foldAttempt(event: AutosaveSchedulerEvent.FoldAttempt) {
+        writer.emit(
+            "fold_branch",
+            "sample_id" to event.sampleId,
+            "attempt_id" to event.attemptId,
+            "branch" to event.branch.name.lowercase(),
+            "fold_now_ns" to event.reading.nowNanos,
+            "deadline_clock" to "scheduler_nano_time",
+            "helper_result" to event.reading.helperResult,
+        )
+    }
+
+    private fun foldCommitted(event: AutosaveSchedulerEvent.FoldCommitted) {
+        val fields = registry.scheduleFields(event.state)
+        if (!writer.invalid) {
+            writer.emit(
+                "fold_committed",
+                "sample_id" to event.sampleId,
+                "attempt_id" to event.attemptId,
+                *fields.toTypedArray(),
+            )
+        }
+    }
+
+    private fun schedulerDecision(event: AutosaveSchedulerEvent.Decision) {
+        val fields = registry.scheduleFields(event.reading.state)
+        if (!writer.invalid) {
+            writer.emit(
+                "scheduler_decision",
+                "branch" to event.branch.name.lowercase(),
+                "decision_now_ns" to event.reading.nowNanos,
+                "due_ns" to event.dueNanos,
+                *fields.toTypedArray(),
+            )
+        }
+    }
+
+    private fun tokenEvent(
+        event: String,
+        token: AutosaveStateToken,
+        vararg fields: Pair<String, Any?>,
+    ) {
+        val id = registry.tokenId(token)
+        if (!writer.invalid) writer.emit(event, "token" to id, *fields)
+    }
+
+    private fun publication(
+        event: String,
+        token: AutosaveStateToken,
+        operation: PersistenceOperationHandle,
+        vararg fields: Pair<String, Any?>,
+    ) {
+        val tokenId = registry.tokenId(token)
+        val operationId = registry.operationId(operation)
+        if (!writer.invalid) writer.emit(event, "token" to tokenId, "operation" to operationId, *fields)
+    }
+}
