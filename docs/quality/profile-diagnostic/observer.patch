+package io.github.hideyukimori.nenepixel.core.application.persistence
+
+/** Temporary #190 diagnostic seam. The prepared patch is never part of a shipping source tree. */
+public fun interface AutosaveDiagnosticObserver {
+    public fun observe(event: AutosaveDiagnosticEvent)
+
+    public companion object {
+        public val None: AutosaveDiagnosticObserver = AutosaveDiagnosticObserver { }
+    }
+}
+
+/** Carries only existing opaque projections and identities; never a document or its contents. */
+public sealed interface AutosaveDiagnosticEvent {
+    public data class RuntimeOperationSet(
+        val setId: Long,
+        val stage: RuntimeSetStage,
+        val transition: RuntimeProjectionTransition<PersistenceOperationProjection>,
+    ) : AutosaveDiagnosticEvent
+
+    public data class RuntimeAutosaveSet(
+        val setId: Long,
+        val stage: RuntimeSetStage,
+        val transition: RuntimeProjectionTransition<AutosaveProjection>,
+    ) : AutosaveDiagnosticEvent
+
+    public data class PublicationPortBegin(
+        val token: AutosaveStateToken,
+        val operation: PersistenceOperationHandle,
+    ) : AutosaveDiagnosticEvent
+
+    public data class PublicationPortEnd(
+        val token: AutosaveStateToken,
+        val operation: PersistenceOperationHandle,
+        val outcome: RecoveryPublicationOutcome,
+    ) : AutosaveDiagnosticEvent
+
+    public data class PublicationRuntimeComplete(
+        val token: AutosaveStateToken,
+        val operation: PersistenceOperationHandle,
+        val result: AutosaveRequestResult,
+    ) : AutosaveDiagnosticEvent
+
+    public data class PublicationIncomplete(
+        val token: AutosaveStateToken,
+        val operation: PersistenceOperationHandle,
+        val reason: PublicationIncompleteReason,
+    ) : AutosaveDiagnosticEvent
+}
+
+public enum class PublicationIncompleteReason { CANCELLED, THREW }
+
+public enum class RuntimeSetStage { INTENT, COMPLETE }
+
+public data class RuntimeProjectionTransition<T>(
+    val old: T,
+    val new: T,
+    val changed: Boolean,
+)
