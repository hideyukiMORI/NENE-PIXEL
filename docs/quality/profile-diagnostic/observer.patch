@@ -0,0 +1,78 @@
+package io.github.hideyukimori.nenepixel.quality.baselineprofile
+
+import android.os.Process
+import android.os.SystemClock
+import android.util.Log
+
+/** Test-process half of the temporary #190 diagnostic patch. */
+internal class ProducerProfileDiagnosticRecorder(
+    private val session: String,
+    private val pid: Int = Process.myPid(),
+    private val nanos: () -> Long = SystemClock::elapsedRealtimeNanos,
+    private val sink: (String) -> Unit = { line -> Log.i("NeneProfileDiag", line) },
+) {
+    private val lock = Any()
+    private val originNanos = nanos()
+    private var sequence = 0
+    private var invalid = false
+
+    init {
+        require(session.matches(SESSION_PATTERN)) { "Invalid diagnostic session" }
+        require(pid > 0) { "Invalid diagnostic process" }
+        event(0, "process_begin")
+    }
+
+    fun event(
+        iteration: Int,
+        event: String,
+    ) {
+        require(iteration in 0..MAX_ITERATIONS) { "Invalid diagnostic iteration" }
+        require(event in EVENTS) { "Invalid diagnostic event" }
+        synchronized(lock) {
+            if (invalid) return
+            if (sequence == EVENT_LIMIT - 1) {
+                invalid = true
+                emit(iteration, "diagnostic_invalid", "event_limit")
+            } else {
+                emit(iteration, event, null)
+            }
+        }
+    }
+
+    private fun emit(
+        iteration: Int,
+        event: String,
+        reason: String?,
+    ) {
+        sequence += 1
+        val reasonField = if (reason == null) "" else ",\"reason\":\"$reason\""
+        sink(
+            "{\"schema\":\"nene-pixel-profile-diagnostic-v1\"," +
+                "\"session\":\"$session\",\"iteration\":$iteration,\"role\":\"producer\"," +
+                "\"pid\":$pid,\"origin_ns\":$originNanos,\"seq\":$sequence," +
+                "\"t_ns\":${nanos()},\"event\":\"$event\"$reasonField}",
+        )
+    }
+
+    private companion object {
+        const val MAX_ITERATIONS = 15
+        const val EVENT_LIMIT = 512
+        val SESSION_PATTERN = Regex("[A-Za-z0-9_-]{1,64}")
+        val EVENTS =
+            setOf(
+                "process_begin",
+                "iteration_begin",
+                "launch_begin",
+                "launch_end",
+                "recovery_discard_begin",
+                "recovery_discard_end",
+                "pencil_begin",
+                "pencil_end",
+                "dirty_observed",
+                "undo_begin",
+                "undo_end",
+                "clean_observed",
+                "ui_block_end",
+            )
+    }
+}
