+package io.github.hideyukimori.nenepixel
+
+import io.github.hideyukimori.nenepixel.core.application.persistence.AutosaveDiagnosticEvent
+import io.github.hideyukimori.nenepixel.core.application.persistence.AutosaveDiagnosticObserver
+import io.github.hideyukimori.nenepixel.core.application.persistence.AutosaveLastOutcome
+import io.github.hideyukimori.nenepixel.core.application.persistence.AutosaveProjection
