+private class ProfileDiagnosticRegistry(
+    private val writer: ProfileDiagnosticWriter,
+    private val limits: ProfileDiagnosticLimits,
+) {
+    private val tokens = ArrayList<AutosaveStateToken>()
+    private val operations = ArrayList<PersistenceOperationHandle>()
+    private val gates = ArrayList<PersistenceOperationProjection>()
+
+    fun observationFields(sample: AutosaveObservation): List<Pair<String, Any?>> =
+        listOf(
+            "pending" to tokenId(sample.states.pending),
+            "published" to tokenId(sample.states.published),
+            "publishing" to tokenId(sample.states.publishing),
+            "gate" to gateId(sample.gate),
+            *gateFields("gate", sample.gate).toTypedArray(),
+            "flushes" to sample.flushes,
+            "requestable" to sample.states.requestable,
+        )
+
+    fun scheduleFields(state: AutosaveSchedule): List<Pair<String, Any?>> =
+        observationFields(state.observation) +
+            listOf(
+                "quiet_deadline_ns" to state.quietDeadlineNanos,
+                "cap_deadline_ns" to state.capDeadlineNanos,
+                "deadline_clock" to "scheduler_nano_time",
+                "suspended" to state.suspended,
+            )
+
+    fun autosaveFields(
+        prefix: String,
+        state: AutosaveProjection,
+    ): List<Pair<String, Any?>> =
+        listOf(
+            "${prefix}_pending" to tokenId(state.pendingStateToken),
+            "${prefix}_published" to tokenId(state.publishedStateToken),
+            "${prefix}_publishing" to tokenId(state.publishingStateToken),
+            "${prefix}_outcome" to lastOutcome(state.lastOutcome),
+        )
+
+    fun tokenId(token: AutosaveStateToken?): Int? =
+        when {
+            token == null || writer.invalid -> {
+                null
+            }
+
+            else -> {
+                val known = tokens.indexOfFirst { it == token }
+                when {
+                    known >= 0 -> {
+                        known + 1
+                    }
+
+                    tokens.size == limits.tokenLimit -> {
+                        writer.invalidate("token_limit")
+                        null
+                    }
+
+                    else -> {
+                        tokens.add(token)
+                        tokens.size
+                    }
+                }
+            }
+        }
+
+    fun operationId(operation: PersistenceOperationHandle): Int? =
+        when {
+            writer.invalid -> {
+                null
+            }
+
+            else -> {
+                val known = operations.indexOfFirst { it === operation }
+                when {
+                    known >= 0 -> {
+                        known + 1
+                    }
+
+                    operations.size == limits.operationLimit -> {
+                        writer.invalidate("operation_limit")
+                        null
+                    }
+
+                    else -> {
+                        operations.add(operation)
+                        operations.size
+                    }
+                }
+            }
+        }
+
+    fun gateId(value: Any?): Int? =
+        when {
+            value == null || writer.invalid -> {
+                null
+            }
+
+            value !is PersistenceOperationProjection || !safeGate(value) -> {
+                writer.invalidate("unsupported_gate")
+                null
+            }
+
+            else -> {
+                val known = gates.indexOfFirst { it == value }
+                when {
+                    known >= 0 -> {
+                        known + 1
+                    }
+
+                    gates.size == limits.operationLimit -> {
+                        writer.invalidate("operation_limit")
+                        null
+                    }
+
+                    else -> {
+                        gates.add(value)
+                        gates.size
+                    }
+                }
+            }
+        }
+
+    private fun safeGate(gate: PersistenceOperationProjection): Boolean {
+        val safePhase =
+            when (gate.phase) {
+                PersistenceOperationPhase.Initializing,
+                PersistenceOperationPhase.Idle,
+                is PersistenceOperationPhase.Discarding,
+                -> true
+
+                else -> false
+            }
+        val safeRecovery =
+            when (gate.recoveryStatus) {
+                RecoveryStatus.Initializing,
+                RecoveryStatus.Clear,
+                RecoveryStatus.UnadoptedCandidate,
+                is RecoveryStatus.Unknown,
+                -> true
+
+                else -> false
+            }
+        val safeOutcome =
+            when (gate.lastOutcome) {
+                PersistenceLastOutcome.None,
+                PersistenceLastOutcome.RecoveryDeclined,
+                -> true
+
+                else -> false
+            }
+        return safePhase && safeRecovery && safeOutcome
+    }
+
+    fun gateFields(
+        prefix: String,
+        value: Any?,
+    ): List<Pair<String, Any?>> =
+        if (value is PersistenceOperationProjection && safeGate(value)) {
+            listOf(
+                "${prefix}_phase" to safePhaseName(value.phase),
+                "${prefix}_recovery" to safeRecoveryName(value.recoveryStatus),
+                "${prefix}_last_outcome" to safePersistenceOutcomeName(value.lastOutcome),
+            )
+        } else {
+            emptyList()
+        }
+}
+
+private class ProfileDiagnosticWriter(
+    private val context: ProfileDiagnosticContext,
+    private val nanos: () -> Long,
+    private val sink: (String) -> Unit,
+    private val limits: ProfileDiagnosticLimits,
+) {
+    private val originNanos = nanos()
+    private var sequence = 0
+    var invalid = false
+        private set
+
+    init {
+        require(context.session.matches(SESSION_PATTERN)) { "Invalid diagnostic session" }
+        require(context.iteration in 1..MAX_ITERATIONS) { "Invalid diagnostic iteration" }
+        require(context.pid > 0) { "Invalid diagnostic process" }
+        emit("process_begin")
+    }
+
+    fun invalidate(reason: String) {
+        if (invalid) return
+        invalid = true
+        emit("diagnostic_invalid", "reason" to reason)
+    }
+
+    fun emit(
+        event: String,
+        vararg fields: Pair<String, Any?>,
+    ) {
+        if (sequence == limits.eventLimit - 1 && event != "diagnostic_invalid") {
+            invalidate("event_limit")
+            return
+        }
+        if (sequence >= limits.eventLimit) return
+        sequence += 1
+        val values =
+            listOf(
+                "schema" to SCHEMA,
+                "session" to context.session,
+                "iteration" to context.iteration,
+                "role" to "app",
+                "pid" to context.pid,
+                "origin_ns" to originNanos,
+                "seq" to sequence,
+                "t_ns" to nanos(),
+                "event" to event,
+            ) + fields
+        sink(
+            values.joinToString(
+                separator = ",",
+                prefix = "{",
+                postfix = "}",
+            ) { (key, value) -> "\"$key\":${json(value)}" },
+        )
+    }
+
+    private fun json(value: Any?): String =
+        when (value) {
+            null -> {
+                "null"
+            }
+
+            is Boolean, is Int, is Long -> {
+                value.toString()
+            }
+
+            is String -> {
+                require(value.matches(SAFE_TEXT)) { "Unsafe diagnostic text" }
+                "\"$value\""
+            }
+
+            else -> {
+                error("Unsupported diagnostic field")
+            }
+        }
+
+    private companion object {
+        const val SCHEMA = "nene-pixel-profile-diagnostic-v1"
+        const val MAX_ITERATIONS = 15
+        val SESSION_PATTERN = Regex("[A-Za-z0-9_-]{1,64}")
+        val SAFE_TEXT = Regex("[A-Za-z0-9_-]+")
+    }
+}
+
+internal data class ProfileDiagnosticContext(
+    val session: String,
+    val iteration: Int,
+    val pid: Int,
+)
+
+internal data class ProfileDiagnosticLimits(
+    val tokenLimit: Int = MAX_DIAGNOSTIC_TOKENS,
+    val operationLimit: Int = MAX_DIAGNOSTIC_OPERATIONS,
+    val eventLimit: Int = MAX_DIAGNOSTIC_EVENTS,
+) {
+    init {
+        require(tokenLimit in 1..MAX_DIAGNOSTIC_TOKENS)
+        require(operationLimit in 1..MAX_DIAGNOSTIC_OPERATIONS)
+        require(eventLimit in 2..MAX_DIAGNOSTIC_EVENTS)
+    }
+}
+
+private const val MAX_DIAGNOSTIC_TOKENS = 128
+private const val MAX_DIAGNOSTIC_OPERATIONS = 128
+private const val MAX_DIAGNOSTIC_EVENTS = 4096
+
+private fun safePhaseName(phase: PersistenceOperationPhase): String =
+    when (phase) {
+        PersistenceOperationPhase.Initializing -> "initializing"
+        PersistenceOperationPhase.Idle -> "idle"
+        is PersistenceOperationPhase.Discarding -> "discarding"
+        else -> error("Unsupported diagnostic gate phase")
+    }
+
+private fun safeRecoveryName(status: RecoveryStatus): String =
+    when (status) {
+        RecoveryStatus.Initializing -> "initializing"
+        RecoveryStatus.Clear -> "clear"
+        RecoveryStatus.UnadoptedCandidate -> "unadopted_candidate"
+        is RecoveryStatus.Unknown -> "unknown"
+        else -> error("Unsupported diagnostic recovery status")
+    }
+
+private fun safePersistenceOutcomeName(outcome: PersistenceLastOutcome): String =
+    when (outcome) {
+        PersistenceLastOutcome.None -> "none"
+        PersistenceLastOutcome.RecoveryDeclined -> "recovery_declined"
+        else -> error("Unsupported diagnostic persistence outcome")
+    }
+
+private fun publicationResult(outcome: RecoveryPublicationOutcome): String =
+    when (outcome) {
+        is RecoveryPublicationOutcome.Published -> "published"
+        RecoveryPublicationOutcome.Stale -> "stale"
+        RecoveryPublicationOutcome.GenerationExhausted -> "generation_exhausted"
+        is RecoveryPublicationOutcome.Failed -> "failed"
+        is RecoveryPublicationOutcome.Uncertain -> "uncertain"
+    }
+
+private fun requestResult(result: AutosaveRequestResult): String =
+    when (result) {
+        is AutosaveRequestResult.Published -> "published"
+        AutosaveRequestResult.NoCapture -> "no_capture"
+        AutosaveRequestResult.Deferred -> "deferred"
+        AutosaveRequestResult.OfferPending -> "offer_pending"
+        AutosaveRequestResult.Unavailable -> "unavailable"
+        AutosaveRequestResult.Stale -> "stale"
+        AutosaveRequestResult.GenerationExhausted -> "generation_exhausted"
+        AutosaveRequestResult.IdentityExhausted -> "identity_exhausted"
+        is AutosaveRequestResult.Failed -> "failed"
+        is AutosaveRequestResult.Uncertain -> "uncertain"
+    }
+
+private fun lastOutcome(outcome: AutosaveLastOutcome): String =
+    when (outcome) {
+        AutosaveLastOutcome.None -> "none"
+        is AutosaveLastOutcome.Published -> "published"
+        AutosaveLastOutcome.Deferred -> "deferred"
+        AutosaveLastOutcome.OfferPending -> "offer_pending"
+        AutosaveLastOutcome.Stale -> "stale"
+        AutosaveLastOutcome.GenerationExhausted -> "generation_exhausted"
+        is AutosaveLastOutcome.Failed -> "failed"
+        is AutosaveLastOutcome.Uncertain -> "uncertain"
+    }
